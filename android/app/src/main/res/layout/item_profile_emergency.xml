<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="24dp">

    <!-- Profile Header Row with Image and Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginRight="16dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/launcher_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dobText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B0BEC5"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Info Tags (Age, Blood Type, Organ Donor) -->
    <LinearLayout
        android:id="@+id/tagsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <!-- Programmatically populated with item_emergency_tag -->
    </LinearLayout>

    <!-- Chronic Conditions Card -->
    <LinearLayout
        android:id="@+id/conditionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHRONIC CONDITIONS"
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/conditionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Allergies Card -->
    <LinearLayout
        android:id="@+id/allergiesCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALLERGIES &amp; REACTION NOTES"
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/allergiesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Active Medications Card -->
    <LinearLayout
        android:id="@+id/medicationsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVE MEDICATIONS"
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/medicationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Emergency Contacts Card -->
    <LinearLayout
        android:id="@+id/contactsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IN CASE OF EMERGENCY (ICE)"
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/contactsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Visual divider between profiles -->
    <View
        android:id="@+id/profileDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#2C2C2C"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

</LinearLayout>
